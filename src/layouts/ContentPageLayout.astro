---
import BaseLayout from "./BaseLayout.astro";

type Props = {
  title: string;
  description: string;
  current: "about" | "projects" | "writing";
};

const { title, description, current } = Astro.props;
---

<BaseLayout title={title} description={description} current={current} compact>
  <article class="content-page">
    <header class="content-header">
      <h1>{title}</h1>
      <div class="content-intro"><slot name="intro" /></div>
    </header>
    <div class="content-body"><slot /></div>
  </article>
</BaseLayout>

<style>
  .content-page {
    max-width: 760px;
    margin-inline: auto;
  }

  .content-header h1 {
    font-size: clamp(1.7rem, 3vw, 2rem);
    line-height: 1.25;
  }

  .content-intro {
    margin-top: 1rem;
    color: var(--muted);
  }

  .content-intro :global(p + p) {
    margin-top: 0.8rem;
  }

  .content-body {
    margin-top: 2rem;
  }

  .content-body :global(.directory-group) {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }

  .content-body :global(.directory-group + .directory-group) {
    margin-top: 1.8rem;
  }

  .content-body :global(.directory-label) {
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.65;
  }

  .content-body :global(.directory-entry + .directory-entry) {
    border-top: 1px solid var(--border);
    margin-top: 1.1rem;
    padding-top: 1.1rem;
  }

  .content-body :global(.directory-title) {
    color: var(--accent);
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .content-body :global(.directory-description) {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: var(--body-size);
    line-height: 1.65;
  }

  .content-body :global(.directory-meta) {
    display: block;
    margin-top: 0.4rem;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 0.76rem;
  }

  .content-body :global(.plain-list) {
    margin: 0;
  }

  @media (max-width: 760px) {
    .content-body :global(.directory-group) {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }
</style>
