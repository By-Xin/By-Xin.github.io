---
const target = "/writing/east-wind/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Moved: East Wind</title>
    <script is:inline>
      window.location.replace("/writing/east-wind/");
    </script>
  </head>
  <body>
    <p>
      This page has moved to <a href={target}>/writing/east-wind/</a>.
    </p>
  </body>
</html>
