---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archive } from "../data/site";
---

<BaseLayout
  current="writing"
  title="Writing"
  description="Short writing, bookmark shelves, and archived fragments."
>
  <section class="section" aria-labelledby="writing-title">
    <p class="section-kicker">writing</p>
    <div class="section-body">
      <h1 id="writing-title">Writing</h1>
      <p class="section-intro">
        Short notes, bookmark shelves, and fragments from the previous site.
        Longer, connected technical writing belongs in BYNotes.
      </p>
      <div class="entry-list">
        {
          archive.map((item) => (
            <article class="entry">
              <div>
                <a class="entry-title" href={item.href}>{item.title}</a>
                <p>{item.description}</p>
              </div>
              <span class="entry-meta">{item.date}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
