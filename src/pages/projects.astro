---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/site";
---

<BaseLayout
  current="projects"
  title="Projects"
  description="Selected projects and maintained public work."
>
  <section class="section" aria-labelledby="projects-title">
    <p class="section-kicker">projects</p>
    <div class="section-body">
      <h1 id="projects-title">Projects</h1>
      <p class="section-intro">
        A small index of maintained work and research-adjacent material. The
        list is deliberately compact so it can be kept current.
      </p>
      <div class="entry-list">
        {
          projects.map((project) => (
            <article class="entry">
              <div>
                <a class="entry-title" href={project.href}>{project.name}</a>
                <p>{project.description}</p>
                {project.repo && <p><a href={project.repo}>Repository</a></p>}
              </div>
              <span class="entry-meta">{project.meta}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
