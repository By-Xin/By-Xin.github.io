---
import ContentPageLayout from "../layouts/ContentPageLayout.astro";
import { projects } from "../data/site";
import { publications } from "../data/publications";
import PublicationEntry from "../components/PublicationEntry.astro";

const groups = [
  { key: "research", title: "Research" },
  { key: "side", title: "Side projects" },
]
  .map((group) => ({
    ...group,
    items: projects.filter((project) => project.group === group.key),
  }))
  .filter((group) => group.items.length > 0);
---

<ContentPageLayout
  current="projects"
  title="Projects"
  description="Research projects, publications, code, and side projects."
>
      <p slot="intro">
        Publications, preprints, and side projects.
      </p>
      {publications.length > 0 && (
        <section class="directory-group" aria-labelledby="papers-title">
          <h2 class="directory-label" id="papers-title">Publications &amp; Preprints</h2>
          <div>
            {publications.map((item) => <PublicationEntry item={item} />)}
          </div>
        </section>
      )}
      {
        groups.map((group) => (
          <section class="directory-group" aria-label={group.title}>
            <h2 class="directory-label">{group.title}</h2>
            <div>
              {group.items.map((project) => (
                <article class="directory-entry">
                    <a class="directory-title" href={project.href}>{project.name}</a>
                    {project.description && <p class="directory-description">{project.description}</p>}
                    <span class="directory-meta">{project.meta}</span>
                    {project.repo && <p class="directory-description"><a href={project.repo}>Repository</a></p>}
                </article>
              ))}
            </div>
          </section>
        ))
      }
</ContentPageLayout>
