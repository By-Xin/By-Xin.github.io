---
import ContentPageLayout from "../layouts/ContentPageLayout.astro";
import { site } from "../data/site";
---

<ContentPageLayout
  current="about"
  title="About"
  description={`A compact profile for ${site.name}.`}
>
  <Fragment slot="intro">
    <p>
      I am a first-year PhD student in optimization at ACEM, Shanghai Jiao Tong
      University, starting in September 2026, supervised by
      <a href="https://scholar.google.com/citations?user=EbpNaDwAAAAJ&amp;hl=en">Qi Deng</a>.
    </p>
    <p>
      For longer technical notes, see <a href={site.notes}>BYNotes</a>. For
      code and public repositories, see <a href={site.github}>GitHub</a>.
    </p>

  </Fragment>
  <section class="directory-group" aria-labelledby="links-title">
    <h2 class="directory-label" id="links-title">Links</h2>
    <ul class="plain-list">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.notes}>BYNotes</a></li>
      <li><a href={site.github}>GitHub</a></li>
      <li><a href="https://github.com/By-Xin/BYNotes">BYNotes repository</a></li>
    </ul>
  </section>
</ContentPageLayout>
