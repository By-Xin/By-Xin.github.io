---
import ContentPageLayout from "../layouts/ContentPageLayout.astro";
import { site } from "../data/site";
---

<ContentPageLayout
  current="about"
  title="About"
  description={`A compact profile for ${site.name}.`}
>
  <Fragment slot="intro">
    <p>
      I am a first-year PhD student in optimization at ACEM, Shanghai Jiao Tong
      University, supervised by
      <a href="https://scholar.google.com/citations?user=EbpNaDwAAAAJ&amp;hl=en">Qi Deng</a>.
      Previously, I earned a master's degree in statistics from the National
      University of Singapore (NUS) and a bachelor's degree in statistics from
      Shanghai University of Finance and Economics (SUFE), where I was advised by
      <a href="https://statr.me/about/">Yixuan Qiu</a>.
      During my master's studies, I worked as a research assistant in
      <a href="https://www.tengjiaye.com/index2.html">Jiaye Teng</a>'s group.
    </p>
  </Fragment>
</ContentPageLayout>
