---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archive, site } from "../data/site";
---

<BaseLayout current="home">
  <section class="hero" aria-labelledby="home-title">
    <div>
      <p class="eyebrow">optimization × statistics × learning</p>
      <h1 id="home-title">XIN Baiying</h1>
      <p class="lede">
        Hi. This is my personal homepage. I am a very beginner in the ocean of
        optimization, statistics, and learning. And so we beat on.
      </p>
      <div class="actions" aria-label="Primary links">
        <a class="text-link" href={site.notes}>Read BYNotes</a>
        <a class="text-link secondary" href="/projects/">Projects</a>
        <a class="text-link secondary" href={site.github}>GitHub</a>
      </div>
    </div>
    <aside class="hero-aside" aria-label="Current focus">
      <img src="/mark.svg" alt="" aria-hidden="true" />
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </aside>
  </section>

  <section class="section" aria-labelledby="interests-title">
    <p class="section-kicker">01 / focus</p>
    <div class="section-body">
      <h2 id="interests-title">Research Interests</h2>
      <p class="section-intro">
        I am interested in problems that sit across the coordinates of
        statistics, optimization, and learning, including but not limited to
        optimization theory and algorithms, machine learning and deep learning
        modeling, LLMs and their interpretability, and everything about
        statistics.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="notes-title">
    <p class="section-kicker">02 / notes</p>
    <div class="section-body">
      <h2 id="notes-title">BYNotes</h2>
      <div class="note-panel">
        <div>
          <p class="section-intro">
            BYNotes is the maintained Quartz notebook for longer study notes.
            The root homepage links into it without absorbing its structure.
          </p>
          <div class="actions">
            <a class="text-link" href={site.notes}>Open BYNotes</a>
            <a class="text-link secondary" href="https://github.com/By-Xin/BYNotes">
              Repository
            </a>
          </div>
        </div>
        <ul>
          <li>Convex Optimization CMU</li>
          <li>Online Learning</li>
          <li>Learning theory and statistical learning notes</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-title">
    <p class="section-kicker">03 / work</p>
    <div class="section-body">
      <h2 id="projects-title">Selected Projects</h2>
      <p class="section-intro">
        Related projects, notes, and research materials will be gradually
        presented here when they are ready.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-title">
    <p class="section-kicker">04 / writing</p>
    <div class="section-body">
      <h2 id="writing-title">Writing and Archive</h2>
      <div class="entry-list">
        {
          archive.map((item) => (
            <article class="entry">
              <div>
                <a class="entry-title" href={item.href}>{item.title}</a>
                <p>{item.description}</p>
              </div>
              <span class="entry-meta">{item.date}</span>
            </article>
          ))
        }
      </div>
      <a class="text-link secondary" href="/writing/">Writing index</a>
    </div>
  </section>
</BaseLayout>
