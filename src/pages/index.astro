---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBYNotesUpdates } from "../data/bynotes";
import { site } from "../data/site";

const bynotesUpdates = await getBYNotesUpdates();
---

<BaseLayout current="home">
  <section class="hero" aria-labelledby="home-title">
    <div>
      <p class="eyebrow">optimization × statistics × learning</p>
      <h1 id="home-title">By XIN</h1>
      <p class="lede">
        Hi. This is my personal homepage. I am very much a beginner in the ocean
        of optimization, statistics, and learning. And so we beat on.
      </p>
      <div class="actions" aria-label="Primary links">
        <a class="text-link" href="/about/">About</a>
        <a class="text-link secondary" href={site.github}>GitHub</a>
        <a class="text-link secondary" href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="notes-title">
    <p class="section-kicker">01 / notes</p>
    <div class="section-body">
      <h2 id="notes-title">
        <a class="section-title-link" href={site.notes}>Study Notes</a>
      </h2>
      <div class="note-panel">
        <div class="note-panel-heading">
          <p class="eyebrow">Curated notes</p>
          <h3 id="bynotes-recent-updates">Recent Updates</h3>
        </div>
        <ol class="note-updates" aria-labelledby="bynotes-recent-updates">
          {
            bynotesUpdates.map((item) => (
              <li>
                <time datetime={item.date}>
                  {item.displayDate ?? item.date}
                </time>
                <a class="entry-title" href={item.href}>{item.title}</a>
                <p>{item.summary}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-title">
    <p class="section-kicker">02 / work</p>
    <div class="section-body">
      <h2 id="projects-title">
        <a class="section-title-link" href="/projects/">
          Projects and Publications
        </a>
      </h2>
      <p class="section-intro">
        Research projects and publications will be listed here.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-title">
    <p class="section-kicker">03 / writing</p>
    <div class="section-body">
      <h2 id="writing-title">
        <a class="section-title-link" href="/writing/">Writing and Archive</a>
      </h2>
      <p class="section-intro">
        Occasional essays and fragments, mostly in Chinese. Written for myself
        and kept here; the archive is open if you care to read.
      </p>
    </div>
  </section>
</BaseLayout>
