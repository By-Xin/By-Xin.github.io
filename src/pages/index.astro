---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBYNotesUpdates } from "../data/bynotes";
import { site } from "../data/site";

const bynotesUpdates = await getBYNotesUpdates();
---

<BaseLayout current="home">
  <section class="hero" aria-labelledby="home-title">
    <div>
      <h1 id="home-title">{site.name}</h1>
      <p class="lede">
        Hi~ o(*￣▽￣*)ブ<br />
        I am very much a beginner in the ocean of optimization and statistics.
      </p>
      <p class="hero-motto">And so we beat on.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="notes-title">
    <p class="section-kicker">01 / notes</p>
    <div class="section-body">
      <h2 id="notes-title">
        <a class="section-title-link" href={site.notes}>Study Notes</a>
      </h2>
      <div class="note-panel">
        <div class="note-panel-heading">
          <p class="eyebrow">Curated notes</p>
          <h3 id="bynotes-recent-updates">Recent Updates</h3>
        </div>
        <ol class="note-updates" aria-labelledby="bynotes-recent-updates">
          {
            bynotesUpdates.map((item) => (
              <li>
                <time datetime={item.date}>
                  {item.displayDate ?? item.date}
                </time>
                <a class="entry-title" href={item.href}>{item.title}</a>
                <p>{item.summary}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="updates-title">
    <p class="section-kicker">02 / updates</p>
    <div class="section-body">
      <h2 id="updates-title">Recent updates</h2>
      <!-- Add personal updates here as they become available. -->
    </div>
  </section>
</BaseLayout>

<style>
  .hero-motto {
    margin-top: 1.1rem;
    color: var(--accent);
    font-family: "Baskerville", "Palatino Linotype", "Book Antiqua", Georgia, serif;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-style: italic;
    line-height: 1.5;
  }
</style>
