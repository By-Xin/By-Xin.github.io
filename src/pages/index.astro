---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBYNotesUpdates } from "../data/bynotes";
import { site } from "../data/site";
import { publications } from "../data/publications";

const bynotesUpdates = await getBYNotesUpdates();
---

<BaseLayout current="home">
  <section class="hero" aria-labelledby="home-title">
    <div>
      <h1 id="home-title">{site.name}</h1>
      <p class="lede">
        Hi~ o(*￣▽￣*)ブ<br />
        I am very much a beginner in the ocean of optimization and statistics.
      </p>
      <p class="hero-motto">And so we beat on.</p>
    </div>
  </section>

  <section class="recent-updates" aria-labelledby="updates-title">
    <h2 id="updates-title">Recent updates</h2>
    <section class="update-group" aria-labelledby="notes-title">
      <div class="update-group-heading">
        <h3 id="notes-title">01 / notes</h3>
        <a href={site.notes}>All notes <span aria-hidden="true">↗</span></a>
      </div>
      <ol class="note-updates" aria-labelledby="notes-title">
        {
          bynotesUpdates.map((item) => (
            <li>
              <time datetime={item.date}>
                {item.displayDate ?? item.date}
              </time>
              <a class="entry-title" href={item.href}>{item.title}</a>
              <p>{item.summary}</p>
            </li>
          ))
        }
      </ol>
    </section>
    {publications.length > 0 && (
      <section class="update-group" aria-labelledby="publications-title">
        <div class="update-group-heading">
          <h3 id="publications-title">02 / publications &amp; preprints</h3>
        </div>
        <ol class="note-updates" aria-labelledby="publications-title">
          {publications.map((item) => (
            <li>
              <a class="entry-title" href={item.href}>{item.title}</a>
              <p>{item.authors}</p>
              <p class="publication-venue">{item.venue}</p>
              {item.code && <a href={item.code}>Code</a>}
            </li>
          ))}
        </ol>
      </section>
    )}
  </section>
</BaseLayout>

<style>
  .lede {
    font-size: calc(1.08rem - 2px);
  }

  .recent-updates {
    padding-top: 2.6rem;
  }

  .update-group {
    display: grid;
    grid-template-columns: minmax(140px, 0.25fr) minmax(0, 1fr);
    gap: 2rem;
    margin-top: 1.8rem;
    border-top: 1px solid var(--border-strong);
    padding-top: 1.1rem;
  }

  .update-group + .update-group {
    margin-top: 2.6rem;
  }

  .update-group-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .update-group-heading h3 {
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.6;
  }

  .update-group-heading > a {
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .publication-venue {
    font-style: italic;
  }

  @media (max-width: 760px) {
    .update-group {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .update-group-heading {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
    }
  }

  .hero-motto {
    margin-top: 1.1rem;
    color: var(--accent);
    font-family: "Baskerville", "Palatino Linotype", "Book Antiqua", Georgia, serif;
    font-size: clamp(calc(1.25rem - 2px), calc(2.5vw - 2px), calc(1.5rem - 2px));
    font-style: italic;
    line-height: 1.5;
  }
</style>
