---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBYNotesUpdates } from "../data/bynotes";
import { site } from "../data/site";
import { publications } from "../data/publications";
import PublicationEntry from "../components/PublicationEntry.astro";

const bynotesUpdates = await getBYNotesUpdates();
---

<BaseLayout current="home">
  <section class="hero" aria-labelledby="home-title">
    <div>
      <h1 id="home-title">{site.name}</h1>
      <p class="lede">
        Hi~<br />
        I am very much a beginner in the ocean of optimization and statistics.
      </p>
      <p class="hero-motto">
        <img src="/and-so-we-beat-on.svg" alt="And so we beat on …" width="1471" height="188" />
      </p>
    </div>
  </section>

  <section class="recent-updates" aria-labelledby="updates-title">
    <h2 id="updates-title">Recent Updates</h2>
    <section class="update-group" aria-labelledby="notes-title">
      <div class="update-group-heading">
        <h3 id="notes-title">01 / notes</h3>
      </div>
      <ol class="note-updates" aria-labelledby="notes-title">
        {
          bynotesUpdates.map((item) => (
            <li>
              <time datetime={item.date}>
                {item.displayDate ?? item.date}
              </time>
              <a class="entry-title" href={item.href}>{item.title}</a>
              <p>{item.summary}</p>
            </li>
          ))
        }
      </ol>
    </section>
    {publications.length > 0 && (
      <section class="update-group" aria-labelledby="publications-title">
        <div class="update-group-heading">
          <h3 id="publications-title">02 / publications &amp; preprints</h3>
        </div>
        <ol class="note-updates" aria-labelledby="publications-title">
          {publications.map((item) => (
            <li>
              <PublicationEntry item={item} />
            </li>
          ))}
        </ol>
      </section>
    )}
  </section>
</BaseLayout>

<style>
  .recent-updates {
    padding-top: 1.6rem;
  }

  .update-group {
    display: grid;
    grid-template-columns: minmax(140px, 0.25fr) minmax(0, 1fr);
    gap: 2rem;
    margin-top: 1.2rem;
    border-top: 1px solid var(--border-strong);
    padding-top: 1.1rem;
  }

  .update-group + .update-group {
    margin-top: 2.6rem;
  }

  .update-group-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .update-group-heading h3 {
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.6;
  }

  .update-group-heading > a {
    font-size: 0.88rem;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .update-group {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .update-group-heading {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
    }
  }

  .hero-motto {
    margin-top: 1.1rem;
  }

  .hero-motto img {
    display: block;
    width: 240px;
    max-width: 100%;
    height: auto;
  }
</style>
