---
import ContentPageLayout from "../../layouts/ContentPageLayout.astro";
import LinkMark from "../../components/LinkMark.astro";
import { collections, getEssayEntries, isoDate } from "../../data/writing";

const essays = await getEssayEntries();
const years = [...new Set(essays.map((entry) => entry.date.getUTCFullYear()))];
const byYear = years.map((year) => ({
  year,
  items: essays.filter((entry) => entry.date.getUTCFullYear() === year),
}));
---

<ContentPageLayout
  current="writing"
  title="Writing"
  description="Personal, non-academic writing: essays, fragments, and collections."
>
      <p slot="intro">
        Random words. Technical notes please refer to <a href="/BYNotes/">BYNotes<LinkMark /></a>.
      </p>
    {
      byYear.map(({ year, items }) => (
        <section class="directory-group" aria-label={String(year)}>
          <h2 class="directory-label">{year}</h2>
          <div>
            {items.map((item) => (
              <article class="directory-entry">
                <a class="directory-title" href={item.href}>
                  {item.title}
                </a>
                {item.description && <p class="directory-description">{item.description}</p>}
                <time class="directory-meta" datetime={isoDate(item.date)}>
                  {isoDate(item.date)}
                </time>
              </article>
            ))}
          </div>
        </section>
      ))
    }
    <section class="directory-group" aria-labelledby="collections-title">
      <h2 id="collections-title" class="directory-label">Collections · 收藏</h2>
      <div>
        {
          collections.map((item) => (
            <article class="directory-entry">
              <a class="directory-title" href={item.href}>
                {item.title}
              </a>
              {item.description && <p class="directory-description">{item.description}</p>}
            </article>
          ))
        }
      </div>
    </section>
</ContentPageLayout>
