---

<BaseLayout
  current="writing"
  title="STATDIY bookmarks"
  description="A living bookmark shelf for statistics, data science, mathematics, systems, and academic writing resources."
>
  <article class="prose resource-page">
    <a class="back-link" href="/writing/">Back to writing</a>
    <h1>STATDIY bookmarks</h1>
    <p class="resource-lede">
      This page is a working bookmark shelf for statistics, data science,
      mathematics, systems, and academic writing resources. It folds together the
      older ByCsdiy README list, the Sufe STATDIY wiki, and the four readings
      from the Sufe wiki home page, with duplicate items collapsed.
    </p>
    <p>
      Linked items open the original source. Unlinked book entries are kept as
      reading pointers so the list can stay useful without pretending every item
      has a clean public URL.
    </p>

    <nav class="resource-jump" aria-label="STATDIY sections">
      {
        sections.map((section) => (
          <a href={`#${section.title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`}>
            {section.title}
          </a>
        ))
      }
    </nav>

    {
      sections.map((section) => {
        const id = section.title
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-|-$/g, "");

        return (
          <section class="resource-section" id={id}>
            <h2>{section.title}</h2>
            {section.intro && <p class="resource-section-intro">{section.intro}</p>}
            <ul class="bookmark-list">
              {
                section.resources.map((resource) => (
                  <li>
                    <div class="resource-line">
                      <span class="resource-kind">{resource.kind}</span>
                      {resource.href ? (
                        <a href={resource.href}>{resource.title}</a>
                      ) : (
                        <span class="resource-title">{resource.title}</span>
                      )}
                      {resource.rating && (
                        <span class="resource-rating" aria-label={`${resource.rating} of 3 stars`}>
                          {"★".repeat(resource.rating)}
                        </span>
                      )}
                      {resource.meta && <span class="resource-meta">{resource.meta}</span>}
                    </div>
                    {resource.note && <p>{resource.note}</p>}
                  </li>
                ))
              }
            </ul>
          </section>
        );
      })
    }

    <section class="resource-section" id="source-pages">
      <h2>Source Pages</h2>
      <ul class="source-list">
        {
          sourceLinks.map((source) => (
            <li><a href={source.href}>{source.title}</a></li>
          ))
        }
      </ul>
      <p class="bookshelf-note">
        Some book pointers may also have local copies in the old
        <a href="https://github.com/By-Xin/Sufe/tree/main/Bookshelf">Sufe Bookshelf</a>.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .resource-page {
    max-width: 860px;
  }

  .resource-lede {
    color: var(--muted);
    font-size: 1.06rem;
    line-height: 1.58;
  }

  .resource-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin: 1.4rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .resource-section-intro {
    color: var(--muted);
    margin-bottom: 0.85rem;
  }

  .prose .bookmark-list,
  .prose .source-list {
    margin: 0;
    padding-left: 0;
    color: var(--text);
    list-style: none;
  }

  .bookmark-list li {
    padding: 0.78rem 0;
    border-top: 1px solid var(--border);
  }

  .bookmark-list li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .bookmark-list li + li,
  .source-list li + li {
    margin-top: 0;
  }

  .resource-line {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .resource-kind {
    flex: 0 0 5.3rem;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 0.74rem;
  }

  .resource-title {
    font-weight: 600;
  }

  .resource-meta {
    color: var(--quiet);
    font-size: 0.9rem;
  }

  .resource-rating {
    color: var(--accent);
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .bookmark-list p {
    margin-top: 0.28rem;
    margin-left: 5.85rem;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .source-list li {
    padding: 0.35rem 0;
  }

  .bookshelf-note {
    margin-top: 1rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .resource-line {
      display: grid;
      gap: 0.15rem;
    }

    .resource-kind {
      flex-basis: auto;
    }

    .bookmark-list p {
      margin-left: 0;
    }
  }
</style>
